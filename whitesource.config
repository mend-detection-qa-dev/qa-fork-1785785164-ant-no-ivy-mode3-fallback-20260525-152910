# Unified Agent configuration for Mode-3 native Ant probe.
# This probe intentionally targets Mode-3 (binary path scan), NOT Mode-1 (Ivy resolution).
#
# ant.ivyResolveDependencies is NOT set (defaults to false).
# This is intentional: the probe exercises the Mode-3 fallback path where Mend
# fingerprints binary files directly from the filesystem, without invoking Ivy.
# See whitesource/unified-agent .claude/knowledge/resolvers/java-jvm.md §3 Mode 3.

ant.resolveDependencies=true

# G6.c pattern: wildcard filter on Ant Path IDs.
# Mend will scan all path elements whose id matches the pattern "lib.*".
# The build.xml declares <path id="lib.cp">, which matches this pattern.
ant.pathIdIncludes=lib.*

# Do not pass extra parameters to Ant invocation.
ant.externalParams=

# Source files are not excluded from fingerprinting.
# No Java sources exist in this probe so this is effectively a no-op,
# but the flag is explicit for reproducibility.
ant.ignoreSourceFiles=false
